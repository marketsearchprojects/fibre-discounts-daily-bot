# The bot refuses to publish unless this is exactly "true".
REDDIT_APPROVAL_GRANTED=false

# OAuth application approved by Reddit for this exact use case.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=

# Used only to summarise external RSS items. Reddit content is never sent to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Fixed scope. Changing these values is rejected by the application.
REDDIT_USERNAME=FrierenInsights
REDDIT_SUBREDDIT=FibreDiscounts

